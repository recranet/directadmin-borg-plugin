{
    "name": "recranet/directadmin-borg-plugin",
    "description": "BorgBackup management plugin for DirectAdmin.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "symfony/console": "^6.4",
        "symfony/filesystem": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/lock": "^6.4",
        "symfony/process": "^6.4",
        "symfony/validator": "^6.4",
        "twig/twig": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Recranet\\DirectAdminBorg\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "Recranet\\DirectAdminBorg\\Test\\": "test/lib/"
        }
    }
}
