{
    "name": "recranet/directadmin-borg-plugin",
    "description": "BorgBackup management plugin for DirectAdmin.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "symfony/console": "^7.4",
        "symfony/filesystem": "^7.4",
        "symfony/finder": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/process": "^7.4",
        "symfony/validator": "^7.4",
        "twig/twig": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "Recranet\\DirectAdminBorg\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "Recranet\\DirectAdminBorg\\Test\\": "test/lib/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2"
    }
}
