<style>
/* Evolution splices plugin output into skins/evolution/plugin.html, which is a
   bare document -- no stylesheet, no font, margin:0 -- inside
   #plugin-host{display:flex;justify-content:center} wrapping
   #iframe-container{display:inline-block;max-width:100vw}.
   Two consequences this block has to answer for:

     1. Nothing sets a font, so anything unstyled renders in the browser's
        default serif. The stack has to be declared here.
     2. An inline-block in a flex row shrink-wraps to its *minimum* intrinsic
        width, so max-width alone leaves the page collapsed into a narrow
        column and the auto-fit grid never gets past one or two tracks.
        Claiming the viewport is what makes it fill the frame.

   Dark mode. plugin.html is loaded into an iframe that Evolution gives a
   hard-coded white background, and Evolution's own light/dark choice is
   data-mode="dark" on the *parent* <html> -- a user setting, or fixed by the
   admin, independent of the OS. Nothing crosses the frame, so a stylesheet in
   here cannot see it, and prefers-color-scheme alone gets it wrong both ways:
   OS dark under a light Evolution, and the reverse. theme.html.twig copies the
   parent's mode onto this document as data-borg-mode; prefers-color-scheme is
   only the fallback when there is no Evolution parent to ask.

   The page has to paint its own background as well. With dark tokens and no
   body colour the cards go dark on the iframe's white, which is the exact
   breakage this replaced. #plugin-host is the body of plugin.html, so it only
   exists inside Evolution's frame; a legacy skin splicing this fragment into
   its own page never matches it and keeps its own background.

   Every colour is a token, defined once for light and once for dark. The dark
   set is written twice (attribute and media query) because CSS has no way to
   share a declaration block between an @media and a selector. */
.borg-plugin,#plugin-host{--borg-page:#f3f5f8;--borg-fg:#1c2733;--borg-muted:#6b7885;--borg-bg:#fff;--borg-alt:#f6f8fa;
--borg-line:#dfe5ec;--borg-accent:#2f6fd0;--borg-on-accent:#fff;--borg-ok:#1f8a4c;--borg-warn:#a9691a;--borg-err:#c0392b;
--borg-log-bg:#0d1117;--borg-log-fg:#c9d1d9;color-scheme:light}
:root[data-borg-mode=dark] :is(.borg-plugin,#plugin-host){--borg-page:#0d1117;--borg-fg:#e6edf3;--borg-muted:#9aa7b4;
--borg-bg:#161b22;--borg-alt:#1c232c;--borg-line:#30363d;--borg-accent:#58a6ff;--borg-on-accent:#0d1117;--borg-ok:#3fb950;
--borg-warn:#d29922;--borg-err:#f85149;--borg-log-bg:#010409;--borg-log-fg:#c9d1d9;color-scheme:dark}
@media (prefers-color-scheme:dark){:root:not([data-borg-mode]) :is(.borg-plugin,#plugin-host){--borg-page:#0d1117;
--borg-fg:#e6edf3;--borg-muted:#9aa7b4;--borg-bg:#161b22;--borg-alt:#1c232c;--borg-line:#30363d;--borg-accent:#58a6ff;
--borg-on-accent:#0d1117;--borg-ok:#3fb950;--borg-warn:#d29922;--borg-err:#f85149;--borg-log-bg:#010409;
--borg-log-fg:#c9d1d9;color-scheme:dark}}
#plugin-host{background:var(--borg-page);color:var(--borg-fg)}
.borg-plugin{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,
"Noto Sans",sans-serif,"Apple Color Emoji","Segoe UI Emoji";
color:var(--borg-fg);font-size:14px;line-height:1.5;
width:calc(100vw - 32px);max-width:1100px;margin:0 auto;padding:16px 0 32px}
/* Inputs and buttons do not inherit the font stack on their own. */
.borg-plugin input,.borg-plugin select,.borg-plugin textarea,.borg-plugin button{font-family:inherit}
.borg-plugin *{box-sizing:border-box}
/* Bare links would otherwise be the browser's default blue and visited purple,
   unreadable on a dark card. :where() keeps this at the specificity of a single
   class, so .borg-btn, .borg-tab and .borg-date further down still win. */
.borg-plugin :where(a){color:var(--borg-accent);text-decoration:none}
.borg-plugin :where(a):hover{text-decoration:underline}
.borg-head h1{font-size:20px;margin:0 0 2px}
.borg-sub{color:var(--borg-muted);margin:0 0 16px}
.borg-foot{color:var(--borg-muted);font-size:12px;margin-top:24px;padding-top:8px;border-top:1px solid var(--borg-line)}
.borg-tabs{display:flex;flex-wrap:wrap;gap:2px;border-bottom:1px solid var(--borg-line);margin-bottom:16px}
.borg-tab{padding:8px 14px;text-decoration:none;color:var(--borg-muted);border-bottom:2px solid transparent;font-weight:500}
.borg-tab:hover{color:var(--borg-fg)}
.borg-tab.is-active{color:var(--borg-accent);border-bottom-color:var(--borg-accent)}
.borg-alert{padding:10px 12px;border-radius:6px;margin:0 0 12px;border:1px solid transparent}
.borg-alert code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.borg-alert-ok{background:color-mix(in srgb,var(--borg-ok) 10%,transparent);border-color:var(--borg-ok);color:var(--borg-ok)}
.borg-alert-warn{background:color-mix(in srgb,var(--borg-warn) 10%,transparent);border-color:var(--borg-warn);color:var(--borg-warn)}
.borg-alert-err{background:color-mix(in srgb,var(--borg-err) 10%,transparent);border-color:var(--borg-err);color:var(--borg-err)}
.borg-card{background:var(--borg-bg);border:1px solid var(--borg-line);border-radius:8px;padding:16px;margin:0 0 16px}
.borg-card h2{font-size:15px;margin:0 0 12px;font-weight:600}
.borg-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.borg-stat{background:var(--borg-alt);border:1px solid var(--borg-line);border-radius:8px;padding:12px;margin:0}
.borg-stat dt{color:var(--borg-muted);font-size:12px;text-transform:uppercase;letter-spacing:.03em;margin:0 0 4px}
.borg-stat dd{margin:0;font-size:16px;font-weight:600;word-break:break-word}
.borg-table{width:100%;border-collapse:collapse;font-size:13px}
.borg-table th,.borg-table td{text-align:left;padding:7px 10px;border-bottom:1px solid var(--borg-line);vertical-align:top}
.borg-table th{color:var(--borg-muted);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.03em}
.borg-table tr:last-child td{border-bottom:none}
.borg-table td.borg-num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.borg-scroll{overflow-x:auto}
.borg-field{margin:0 0 14px}
.borg-field label{display:block;font-weight:600;margin:0 0 4px}
.borg-field .borg-hint{display:block;color:var(--borg-muted);font-size:12px;margin:4px 0 0}
.borg-field .borg-hint code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.borg-plugin input[type=text],.borg-plugin input[type=password],.borg-plugin input[type=number],
.borg-plugin select,.borg-plugin textarea{width:100%;max-width:560px;padding:7px 9px;border:1px solid var(--borg-line);
border-radius:6px;background:var(--borg-bg);color:var(--borg-fg);font:inherit}
.borg-plugin textarea{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;min-height:120px}
.borg-plugin input[type=checkbox]{margin-right:6px}
.borg-inline{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end}
.borg-inline .borg-field{margin:0}
.borg-btn{display:inline-block;padding:7px 14px;border-radius:6px;border:1px solid var(--borg-line);
background:var(--borg-alt);color:var(--borg-fg);font:inherit;font-weight:600;cursor:pointer;text-decoration:none}
.borg-btn:hover{border-color:var(--borg-accent);color:var(--borg-accent)}
.borg-btn-primary{background:var(--borg-accent);border-color:var(--borg-accent);color:var(--borg-on-accent)}
.borg-btn-primary:hover{opacity:.9;color:var(--borg-on-accent)}
.borg-btn-danger{color:var(--borg-err);border-color:var(--borg-err)}
.borg-btn-danger:hover{background:var(--borg-err);color:var(--borg-on-accent)}
.borg-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;align-items:center}
.borg-badge{display:inline-block;padding:2px 8px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.03em}
.borg-badge-ok{background:color-mix(in srgb,var(--borg-ok) 15%,transparent);color:var(--borg-ok)}
.borg-badge-warn{background:color-mix(in srgb,var(--borg-warn) 15%,transparent);color:var(--borg-warn)}
.borg-badge-err{background:color-mix(in srgb,var(--borg-err) 15%,transparent);color:var(--borg-err)}
.borg-badge-busy{background:color-mix(in srgb,var(--borg-accent) 15%,transparent);color:var(--borg-accent)}
.borg-badge-idle{background:var(--borg-alt);color:var(--borg-muted)}
.borg-log{background:var(--borg-log-bg);color:var(--borg-log-fg);border:1px solid var(--borg-line);border-radius:6px;padding:12px;max-height:420px;overflow:auto;
font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;white-space:pre-wrap;word-break:break-word;margin:0}
.borg-crumbs{margin:0 0 10px;font-size:13px;color:var(--borg-muted);word-break:break-all}
.borg-crumbs a{color:var(--borg-accent);text-decoration:none}
.borg-crumbs a:hover{text-decoration:underline}
.borg-mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px}
.borg-date{display:inline-flex;align-items:center;gap:7px;white-space:nowrap}
.borg-cal{flex:0 0 auto;opacity:.75}
.borg-empty{color:var(--borg-muted);padding:18px;text-align:center}
.borg-note{color:var(--borg-muted);font-size:12px;margin:8px 0 0}
.borg-note code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
@media (max-width:640px){.borg-tab{padding:8px 10px}.borg-table th,.borg-table td{padding:6px}}
</style>
