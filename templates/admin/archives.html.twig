{% if not configured %}
    <div class="borg-card">
        <p class="borg-empty">
            No repository is configured yet. Set one up under <a href="{{ url({ tab: 'repository' }) }}">Repository</a>.
        </p>
    </div>
{% elseif browser %}
    {% if user_restore %}
        <div class="borg-card">
            <h2>Restore a whole user</h2>

            <p class="borg-note" style="margin-top:0">
                Restores the account's home directory together with its DirectAdmin backup
                from <span class="borg-mono">{{ user_restore.admin_backups_dir }}</span>,
                which holds the databases and account configuration.
            </p>

            {% if not user_restore.covered %}
                <div class="borg-alert borg-alert-warn">
                    <span class="borg-mono">{{ user_restore.admin_backups_dir }}</span> is not in your
                    source paths, so this archive has no DirectAdmin backups to restore.
                </div>
            {% endif %}

            <form method="post" action="{{ url({ tab: 'archives', archive: user_restore.archive }) }}">
                <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                <input type="hidden" name="action" value="restore_user">
                <input type="hidden" name="archive" value="{{ user_restore.archive }}">

                <div class="borg-inline">
                    <div class="borg-field">
                        <label for="borg-username">Username</label>
                        <input type="text" id="borg-username" name="username" value="{{ user_restore.username }}"
                               style="max-width:220px" autocapitalize="off" autocorrect="off" spellcheck="false">
                    </div>
                    <div class="borg-field" style="flex:1;min-width:260px">
                        <label for="borg-user-destination">Restore into</label>
                        <input type="text" id="borg-user-destination" name="destination"
                               value="{{ user_restore.default_destination }}">
                    </div>
                </div>

                <div class="borg-field">
                    <label><input type="checkbox" name="in_place" value="1">Restore to the original location instead</label>
                    <span class="borg-hint">
                        Writes straight into the account's home directory and
                        <span class="borg-mono">{{ user_restore.admin_backups_dir }}</span>, ignoring the staging
                        path above. Existing files are <strong>overwritten</strong>; files created since the
                        backup are left in place, so this is an overlay rather than an exact mirror.
                    </span>
                </div>

                <div class="borg-actions">
                    <button class="borg-btn borg-btn-primary" type="submit">Restore user</button>
                </div>
            </form>

            {% if user_restore.missing_account %}
                {# The account is gone, so its home cannot be restored yet. The
                   DirectAdmin backup is what recreates it, so offer just that,
                   as an explicit choice rather than something done for them. #}
                <form method="post" action="{{ url({ tab: 'archives', archive: user_restore.archive }) }}"
                      style="margin-top:12px">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="restore_admin_backup">
                    <input type="hidden" name="archive" value="{{ user_restore.archive }}">
                    <input type="hidden" name="username" value="{{ user_restore.missing_account }}">
                    <input type="hidden" name="destination" value="{{ user_restore.default_destination }}">

                    <p class="borg-note" style="margin-top:0">
                        This plugin does not create accounts. To bring
                        <span class="borg-mono">{{ user_restore.missing_account }}</span> back:
                    </p>
                    <ol class="borg-note" style="margin-top:4px">
                        <li>Restore its DirectAdmin backup into
                            <span class="borg-mono">{{ user_restore.admin_backups_dir }}</span> with the button below.</li>
                        <li>Recreate the account from it with <strong>Admin Level &rarr; Restore Backups</strong>.
                            That is what creates the user, its databases and its configuration.</li>
                        <li>Come back to this archive and restore the home directory.</li>
                    </ol>

                    <div class="borg-field">
                        <label>
                            <input type="checkbox" name="to_directadmin" value="1" checked>
                            Place it in {{ user_restore.admin_backups_dir }} where DirectAdmin looks for it
                        </label>
                        <span class="borg-hint">
                            Restored with its original ownership, which DirectAdmin requires of these files.
                            Untick to write it to the staging path instead and move it yourself.
                        </span>
                    </div>

                    <button class="borg-btn borg-btn-primary" type="submit">
                        Restore {{ user_restore.missing_account }}'s DirectAdmin backup
                    </button>
                </form>
            {% endif %}
        </div>
    {% endif %}

    <div class="borg-card">
        <h2>{{ browser.archive }}</h2>

        {% include 'partial/breadcrumbs.html.twig' with { crumbs: browser.crumbs } %}

        {% if browser.error %}
            <div class="borg-alert borg-alert-err">Could not read the archive: {{ browser.error }}</div>
            <a class="borg-btn" href="{{ url({ tab: 'archives' }) }}">Back to archives</a>
        {% else %}
            {% if browser.truncated %}
                <div class="borg-alert borg-alert-warn">
                    This directory has more entries than can be listed. Open a subdirectory to see the rest.
                </div>
            {% endif %}

            {% if browser.entries is empty %}
                <p class="borg-empty">This directory is empty in the archive.</p>
                <a class="borg-btn" href="{{ url({ tab: 'archives' }) }}">Back to archives</a>
            {% else %}
                <form method="post" action="{{ url({}) }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="restore">
                    <input type="hidden" name="archive" value="{{ browser.archive }}">

                    <div class="borg-scroll">
                        <table class="borg-table">
                            <thead>
                                <tr><th></th><th>Name</th><th>Size</th><th>Modified</th><th>Owner</th><th>Mode</th></tr>
                            </thead>
                            <tbody>
                                {% for entry in browser.entries %}
                                    <tr>
                                        <td><input type="checkbox" name="paths[]" value="{{ entry.path }}"></td>
                                        <td class="borg-mono">
                                            {% if entry.directory %}
                                                <a href="{{ url({ tab: 'archives', archive: browser.archive, path: entry.path }) }}">{{ entry.name }}/</a>
                                            {% else %}
                                                {{ entry.name }}
                                            {% endif %}
                                        </td>
                                        <td class="borg-num">{{ entry.directory ? '-' : entry.size|bytes }}</td>
                                        <td>{{ entry.modified|datetime }}</td>
                                        <td>{{ entry.owner }}</td>
                                        <td class="borg-mono">{{ entry.mode }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <div class="borg-field" style="margin-top:14px">
                        <label for="borg-destination">Restore into</label>
                        <input type="text" id="borg-destination" name="destination" value="{{ browser.default_destination }}">
                        <span class="borg-hint">
                            Files are written below this directory, keeping their full original path.
                            Existing files there are overwritten, so restore into a staging directory
                            rather than straight over live data.
                        </span>
                    </div>

                    <div class="borg-actions">
                        <button class="borg-btn borg-btn-primary" type="submit">Restore selected</button>
                        <a class="borg-btn" href="{{ url({ tab: 'archives' }) }}">Back to archives</a>
                    </div>
                </form>
            {% endif %}
        {% endif %}
    </div>
{% elseif error %}
    <div class="borg-alert borg-alert-err">Could not list archives: {{ error }}</div>
{% elseif archives is empty %}
    <div class="borg-card"><p class="borg-empty">No archives yet. Run a backup from the Overview tab.</p></div>
{% else %}
    <div class="borg-card">
        <h2>Archives ({{ archives|length }})</h2>
        <div class="borg-scroll">
            <table class="borg-table">
                <thead><tr><th>Archive</th><th>Created</th><th>Age</th><th></th></tr></thead>
                <tbody>
                    {% for archive in archives %}
                        <tr>
                            <td class="borg-mono">
                                <a href="{{ url({ tab: 'archives', archive: archive.name }) }}">{{ archive.name }}</a>
                            </td>
                            <td>{{ archive.time|datetime }}</td>
                            <td>{{ archive.time|age }}</td>
                            <td class="borg-num">
                                {# Deleting an archive is irreversible, so it takes the exact name typed back. #}
                                <form method="post" action="{{ url({ tab: 'archives' }) }}" class="borg-inline">
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                    <input type="hidden" name="action" value="delete_archive">
                                    <input type="hidden" name="archive" value="{{ archive.name }}">
                                    <input type="text" name="confirm" placeholder="type name to delete" style="max-width:220px">
                                    <button class="borg-btn borg-btn-danger" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
