{% if not configured %}
    <div class="borg-card">
        <p class="borg-empty">
            No repository is configured yet. Point the plugin at your existing one under
            <a href="{{ url({ tab: 'repository' }) }}">Repository</a>.
        </p>
    </div>
{% elseif browser or accounts or user_panel %}
    {% if accounts %}
        <div class="borg-card">
            <h2>Accounts in this backup ({{ accounts.accounts|length }})</h2>
            <p class="borg-note" style="margin-top:0">
                Pick the account you need to put back.
            </p>

            {% if accounts.accounts is empty %}
                <p class="borg-empty">This archive has no <span class="borg-mono">/home</span> in it.</p>
            {% else %}
                <div class="borg-scroll">
                    <table class="borg-table">
                        <thead><tr><th>Account</th><th>In DirectAdmin</th></tr></thead>
                        <tbody>
                            {% for account in accounts.accounts %}
                                <tr>
                                    <td>
                                        <a class="borg-date" href="{{ url({ tab: 'archives', archive: accounts.archive, user: account.name }) }}">
                                            {% include 'partial/user_icon.html.twig' %}
                                            {{ account.name }}
                                        </a>
                                    </td>
                                    <td>
                                        {% if account.exists %}
                                            <span class="borg-badge borg-badge-ok">present</span>
                                        {% else %}
                                            {# The deleted-account case, which needs DirectAdmin's
                                               own restore before files mean anything. #}
                                            <span class="borg-badge borg-badge-warn">deleted</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <div class="borg-actions">
                <a class="borg-btn" href="{{ url({ tab: 'archives' }) }}">Back to archives</a>
            </div>
        </div>
    {% endif %}

    {% if user_panel %}
        {% include 'admin/_account_panel.html.twig' %}
    {% endif %}

    {% if browser and browser.needs_index %}
        <div class="borg-card">
            <h2>Index this archive first</h2>

            <p class="borg-mono" style="margin-top:0">{{ browser.archive }}</p>

            <p>
                borg cannot list a single directory: it reads the whole archive however
                little you ask for. On a hosting server that is millions of entries, so
                browsing straight through borg would cost a full scan on every click.
            </p>
            <p>
                Indexing reads the archive once, in the background, and writes what it
                finds to disk. After that every directory in this archive opens
                immediately. It only has to happen once &mdash; archives never change.
            </p>

            {% if not browser.index_job %}
                <form method="post" action="{{ url({ tab: 'archives', archive: browser.archive }) }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="build_index">
                    <input type="hidden" name="archive" value="{{ browser.archive }}">

                    <div class="borg-field">
                        <label>
                            <input type="checkbox" name="index_files" value="1"{{ browser.index_default_files ? ' checked' : '' }}>
                            Index individual files as well as directories
                        </label>
                        <span class="borg-hint">
                            Off by default. Files outnumber directories several times over, so
                            leaving this off makes the index a fraction of the size and builds it
                            sooner. It does not change what you can recover: restoring a directory
                            brings back everything inside it either way. Turn it on when you need
                            to pick out single files rather than whole folders.
                        </span>
                    </div>

                    <div class="borg-actions">
                        <button class="borg-btn borg-btn-primary" type="submit">Index this archive</button>
                        <a class="borg-btn" href="{{ url({ tab: 'archives', archive: browser.archive, user: browser.username }) }}">Back to {{ browser.username }}</a>
                    </div>
                </form>
            {% endif %}
        </div>

        {% if browser.index_job %}
            {# Live progress: the page reloads itself when the scan finishes. #}
            {% include 'partial/job_detail.html.twig' with {
                job: browser.index_job,
                log: browser.index_log,
                status_url: browser.index_status_url,
                heading: 'Indexing in progress',
                show_type: false,
                back_url: url({ tab: 'archives' })
            } only %}
        {% endif %}
    {% elseif browser %}
    <div class="borg-card">
        <h2>{{ browser.path }}</h2>

        {% include 'partial/breadcrumbs.html.twig' with { crumbs: browser.crumbs } %}

        {% if browser.error %}
            <div class="borg-alert borg-alert-err">Could not read the archive: {{ browser.error }}</div>
            <a class="borg-btn" href="{{ url({ tab: 'archives' }) }}">Back to archives</a>
        {% else %}
            {% if browser.truncated %}
                <div class="borg-alert borg-alert-warn">
                    This directory has more entries than can be listed. Open a subdirectory to see the rest.
                </div>
            {% endif %}

            {% if not browser.has_files %}
                {# Saying so matters: an empty-looking folder here is not an
                   empty folder in the archive, and restoring it still works. #}
                <div class="borg-alert borg-alert-warn">
                    This archive is indexed by directory only, so individual files are not
                    listed. Selecting a directory still restores everything inside it.
                    <form method="post" action="{{ url({ tab: 'archives', archive: browser.archive, path: browser.path }) }}"
                          style="display:inline">
                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                        <input type="hidden" name="action" value="build_index">
                        <input type="hidden" name="archive" value="{{ browser.archive }}">
                        <input type="hidden" name="index_files" value="1">
                        <button class="borg-btn" type="submit" style="margin-top:8px">Re-index with files</button>
                    </form>
                </div>
            {% endif %}

            {% if browser.entries is empty %}
                <p class="borg-empty">
                    {% if browser.has_files %}
                        This directory is empty in the archive.
                    {% else %}
                        No subdirectories here. This archive is indexed by directory only, so any
                        files in this directory are not shown &mdash; restore the directory above
                        to get them.
                    {% endif %}
                </p>
                <a class="borg-btn" href="{{ url({ tab: 'archives', archive: browser.archive, user: browser.username }) }}">Back to {{ browser.username }}</a>
            {% else %}
                <form method="post" action="{{ url({ tab: 'archives', archive: browser.archive, user: browser.username, path: browser.path }) }}">
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                    <input type="hidden" name="action" value="restore">
                    <input type="hidden" name="archive" value="{{ browser.archive }}">

                    <div class="borg-scroll">
                        <table class="borg-table">
                            <thead>
                                <tr><th></th><th>Name</th><th>Size</th><th>Modified</th><th>Owner</th><th>Mode</th></tr>
                            </thead>
                            <tbody>
                                {% for entry in browser.entries %}
                                    <tr>
                                        <td><input type="checkbox" name="paths[]" value="{{ entry.path }}"></td>
                                        <td class="borg-mono">
                                            {% if entry.directory %}
                                                <a href="{{ url({ tab: 'archives', archive: browser.archive, user: browser.username, path: entry.path }) }}">{{ entry.name }}/</a>
                                            {% else %}
                                                {{ entry.name }}
                                            {% endif %}
                                        </td>
                                        <td class="borg-num">{{ entry.directory ? '-' : entry.size|bytes }}</td>
                                        <td>{{ entry.modified|datetime }}</td>
                                        <td>{{ entry.owner }}</td>
                                        <td class="borg-mono">{{ entry.mode }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <input type="hidden" name="username" value="{{ browser.username }}">

                    <p class="borg-note">
                        Selected items go back to where they came from under
                        <span class="borg-mono">/home/{{ browser.username }}</span>, with their
                        original ownership. Files of the same name are overwritten; nothing else
                        in the directory is touched.
                    </p>

                    <div class="borg-actions">
                        <button class="borg-btn borg-btn-primary" type="submit">Restore selected</button>
                        <a class="borg-btn" href="{{ url({ tab: 'archives', archive: browser.archive, user: browser.username }) }}">Back to {{ browser.username }}</a>
                    </div>
                </form>
            {% endif %}
        {% endif %}
    </div>
    {% endif %}
{% elseif error %}
    <div class="borg-alert borg-alert-err">Could not list archives: {{ error }}</div>
{% elseif archives is empty %}
    <div class="borg-card">
        <p class="borg-empty">
            This repository has no archives yet. They are created by whatever backs this server
            up, not by this plugin.
        </p>
    </div>
{% else %}
    <div class="borg-card">
        <h2>Archives ({{ archives|length }})</h2>

        <div class="borg-scroll">
            <table class="borg-table">
                <thead><tr><th>Date</th><th>Time</th><th>Browsing</th><th></th></tr></thead>
                <tbody>
                    {% for archive in archives %}
                        <tr>
                            <td>
                                <a class="borg-date" href="{{ url({ tab: 'archives', archive: archive.name }) }}">
                                    {% include 'partial/calendar_icon.html.twig' %}
                                    {{ archive.taken_at|date_only }}
                                </a>
                            </td>
                            <td class="borg-num">{{ archive.taken_at|time_only }}</td>
                            <td>
                                {% if archive.stale %}
                                    {# Built before a setting changed, so it no longer answers
                                       the question the restore screen asks of it. #}
                                    <span class="borg-badge borg-badge-warn">needs refresh</span>
                                {% elseif archive.indexed %}
                                    <span class="borg-badge borg-badge-ok">indexed</span>
                                {% else %}
                                    <span class="borg-badge borg-badge-idle">not indexed</span>
                                {% endif %}
                            </td>
                            <td class="borg-num">
                                {% if archive.indexed %}
                                    <form method="post" action="{{ url({ tab: 'archives' }) }}" style="display:inline">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
                                        <input type="hidden" name="action" value="build_index">
                                        <input type="hidden" name="archive" value="{{ archive.name }}">
                                        <button class="borg-btn{{ archive.stale ? ' borg-btn-primary' : '' }}" type="submit">Refresh</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endif %}
