<form method="post" action="{{ url({}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="action" value="save_repository">

    <div class="borg-card">
        <h2>Existing repository</h2>

        <p class="borg-note" style="margin-top:0">
            This plugin restores; it does not back up. Point it at the repository your server
            already writes to. It is saved only if borg finds a repository there &mdash; nothing
            is ever created, so a typo cannot leave you with an empty repository that looks fine.
        </p>

        <div class="borg-field">
            <label for="borg-repository">Repository location</label>
            <input type="text" id="borg-repository" name="repository" value="{{ config.repository }}"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="borg-hint">
                Local path (<code>/mnt/bigstorage/borg/$(hostname)</code>),
                <code>ssh://user@host:22/path</code> or <code>user@host:/path</code>.
                Do not include <code>::archive</code>. Repositories are usually per-host, so
                check the exact path in the script that runs your backups.
            </span>
        </div>

        <div class="borg-field">
            <label for="borg-ssh">SSH command (BORG_RSH)</label>
            <input type="text" id="borg-ssh" name="ssh_command" value="{{ config.ssh_command }}"
                   autocapitalize="off" autocorrect="off" spellcheck="false">
            <span class="borg-hint">
                Only for a remote repository, and it has to match what your backup script exports.
                For example <code>ssh -i /root/.ssh/borg_ed25519 -p 23</code>.
            </span>
        </div>

        <div class="borg-field">
            <label for="borg-passphrase">Passphrase</label>
            <input type="password" id="borg-passphrase" name="passphrase" value="" autocomplete="new-password">
            <span class="borg-hint">
                {% if has_passphrase %}
                    A passphrase is stored. Leave blank to keep it.
                {% else %}
                    Only needed for an encrypted repository. Stored at
                    <code>{{ passphrase_file }}</code>, mode 0600, root-only.
                {% endif %}
            </span>
        </div>

        <div class="borg-field">
            <label><input type="checkbox" name="clear_passphrase" value="1">Remove the stored passphrase</label>
        </div>

        {% if detected.reachable %}
            <div class="borg-alert borg-alert-ok">
                Repository found: {{ detected.archive_count }} archive(s), encryption
                {{ detected.encryption ?: 'unknown' }}{% if detected.short_id %}, id
                <code>{{ detected.short_id }}…</code>{% endif %}.
            </div>
        {% elseif configured and detected.error %}
            <div class="borg-alert borg-alert-err">
                The saved location cannot be read right now: {{ detected.error }}
            </div>
        {% endif %}
    </div>

    <div class="borg-card">
        <h2>Restore settings</h2>

        <div class="borg-field">
            <label for="borg-admin-backups">DirectAdmin backups directory</label>
            <input type="text" id="borg-admin-backups" name="admin_backups_dir" value="{{ config.admin_backups_dir }}">
            <span class="borg-hint">
                Where DirectAdmin writes its own per-user backups, as they appear
                <em>inside the archive</em>. Restoring a whole account needs these: they hold the
                databases and the account configuration, which a home directory does not.
            </span>
        </div>

        <div class="borg-field">
            <label>
                <input type="checkbox" name="restore_admin_backup" value="1"{{ config.restore_admin_backup ? ' checked' : '' }}>
                Offer to restore the DirectAdmin backup alongside a home directory
            </label>
        </div>

        <div class="borg-field">
            <label>
                <input type="checkbox" name="user_restore_enabled" value="1"{{ config.user_restore_enabled ? ' checked' : '' }}>
                Let users restore their own files
            </label>
            <span class="borg-hint">
                Adds a Restore Files entry at User Level, scoped to the account's own home
                directory. Their restores land in <code>~/{{ user_restore_dir }}</code> and never
                over their live files &mdash; unlike the restores on this screen, which put files
                back where they came from.
            </span>
        </div>
    </div>

    <div class="borg-card">
        <div class="borg-actions">
            <button class="borg-btn borg-btn-primary" type="submit">Verify and save</button>
        </div>
        <p class="borg-note">
            Saved to <code>{{ config_file }}</code>, outside the plugin directory, so updating
            the plugin does not lose it.
        </p>
    </div>
</form>
