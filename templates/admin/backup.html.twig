<form method="post" action="{{ url({}) }}">
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
    <input type="hidden" name="action" value="save_backup">

    <div class="borg-card">
        <h2>What to back up</h2>

        <div class="borg-field">
            <label for="borg-sources">Source paths</label>
            <textarea id="borg-sources" name="source_paths" rows="6">{{ config.source_paths|join("\n") }}</textarea>
            <span class="borg-hint">One absolute path per line.</span>
        </div>

        <div class="borg-field">
            <label for="borg-excludes">Exclude patterns</label>
            <textarea id="borg-excludes" name="exclude_patterns" rows="6">{{ config.exclude_patterns|join("\n") }}</textarea>
            <span class="borg-hint">One borg pattern per line, for example <code>sh:/home/*/.cache/**</code>.</span>
        </div>

        <div class="borg-field">
            <label><input type="checkbox" name="one_file_system" value="1"{{ config.one_file_system ? ' checked' : '' }}>Do not cross filesystem boundaries</label>
            <span class="borg-hint">Skips other mounts found beneath the source paths.</span>
        </div>
    </div>

    <div class="borg-card">
        <h2>Archive</h2>

        <div class="borg-field">
            <label for="borg-archive-name">Archive name template</label>
            <input type="text" id="borg-archive-name" name="archive_name" value="{{ config.archive_name }}">
            <span class="borg-hint">borg placeholders, e.g. <code>{hostname}-{now:%Y-%m-%d_%H:%M:%S}</code>.</span>
        </div>

        <div class="borg-field">
            <label for="borg-archive-prefix">Archive prefix</label>
            <input type="text" id="borg-archive-prefix" name="archive_prefix" value="{{ config.archive_prefix }}">
            <span class="borg-hint">
                Scopes pruning to this plugin's own archives, so it can never delete archives
                another tool wrote to the same repository. Must match the start of the name template.
            </span>
        </div>

        <div class="borg-field">
            <label for="borg-compression">Compression</label>
            <input type="text" id="borg-compression" name="compression" value="{{ config.compression }}">
            <span class="borg-hint"><code>lz4</code> (fastest), <code>zstd,6</code> (balanced), <code>zlib,9</code> (smallest).</span>
        </div>
    </div>

    <div class="borg-card">
        <h2>Retention</h2>

        <div class="borg-field">
            <label><input type="checkbox" name="prune_enabled" value="1"{{ config.prune_enabled ? ' checked' : '' }}>Prune old archives after each backup</label>
        </div>

        <div class="borg-inline">
            <div class="borg-field">
                <label for="borg-keep-daily">Keep daily</label>
                <input type="number" min="0" max="9999" style="max-width:120px" id="borg-keep-daily" name="keep_daily" value="{{ config.keep_daily }}">
            </div>
            <div class="borg-field">
                <label for="borg-keep-weekly">Keep weekly</label>
                <input type="number" min="0" max="9999" style="max-width:120px" id="borg-keep-weekly" name="keep_weekly" value="{{ config.keep_weekly }}">
            </div>
            <div class="borg-field">
                <label for="borg-keep-monthly">Keep monthly</label>
                <input type="number" min="0" max="9999" style="max-width:120px" id="borg-keep-monthly" name="keep_monthly" value="{{ config.keep_monthly }}">
            </div>
        </div>

        <p class="borg-note">0 disables a rule. With every rule at 0 nothing is ever pruned.</p>

        <div class="borg-field">
            <label><input type="checkbox" name="compact_after_prune" value="1"{{ config.compact_after_prune ? ' checked' : '' }}>Compact the repository after pruning</label>
            <span class="borg-hint">Reclaims disk space. Requires borg 1.2 or newer.</span>
        </div>
    </div>

    <div class="borg-card">
        <h2>Schedule</h2>

        <div class="borg-field">
            <label><input type="checkbox" name="schedule_enabled" value="1"{{ config.schedule_enabled ? ' checked' : '' }}>Run a backup automatically</label>
            <span class="borg-hint">Writes <code>{{ cron_file }}</code>.</span>
        </div>

        <div class="borg-inline">
            <div class="borg-field">
                <label for="borg-hour">Hour</label>
                <input type="text" id="borg-hour" name="schedule_hour" value="{{ config.schedule_hour }}">
            </div>
            <div class="borg-field">
                <label for="borg-minute">Minute</label>
                <input type="text" id="borg-minute" name="schedule_minute" value="{{ config.schedule_minute }}">
            </div>
        </div>

        <p class="borg-note">
            Cron syntax is accepted, so <code>*/6</code> in Hour means every six hours.
            Current: {{ schedule_description }}
        </p>

        <div class="borg-field">
            <label><input type="checkbox" name="run_after_da_backups" value="1"{{ config.run_after_da_backups ? ' checked' : '' }}>Also run after DirectAdmin's own backups finish</label>
            <span class="borg-hint">
                Uses the <code>all_backups_post</code> hook, so the archive includes the
                DirectAdmin backup files that were just written.
            </span>
        </div>
    </div>

    <div class="borg-card">
        <h2>User restores</h2>

        <div class="borg-field">
            <label><input type="checkbox" name="user_restore_enabled" value="1"{{ config.user_restore_enabled ? ' checked' : '' }}>Let users restore their own files</label>
            <span class="borg-hint">Adds a user-level page, limited to the user's own home directory.</span>
        </div>

        <div class="borg-field">
            <label for="borg-restore-dir">Restore directory name</label>
            <input type="text" id="borg-restore-dir" name="user_restore_dir" value="{{ config.user_restore_dir }}">
            <span class="borg-hint">
                Restores are written to <code>/home/&lt;user&gt;/&lt;name&gt;/</code> and never overwrite live files.
            </span>
        </div>
    </div>

    <div class="borg-actions"><button class="borg-btn borg-btn-primary" type="submit">Save settings</button></div>
</form>
